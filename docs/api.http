@publicHost = development.experimente.test
@catalogCitySlug = londrina
@catalogCategorySlug = bares
@catalogEstablishmentSlug = bar-estacao-43-londrina
@organizationId = 1
@analyticsEventId = 0198f4a1-5d42-7a6f-9d3b-6c1a2f4e8b90

### Experimente+ API HTTP Requests
### Base URL: http://localhost:3333
###
### Authentication: Most endpoints require JWT Bearer token
### Include header: Authorization: Bearer <token>
###
### API Conventions:
### - Content-Type: application/json (except file uploads)
### - Timestamps: ISO 8601 format
### - Database fields: snake_case naming
### - Pagination: ?page=1&per_page=10
### - Sorting: ?sort_by=field&order=asc|desc
### - Search: ?search=term

### Variables (safe placeholders; replace only when running legacy requests below)
@baseUrl = http://localhost:3333
@token = replace-with-access-token
@refreshToken = replace-with-opaque-refresh-token
@passwordResetToken = sample-opaque-password-reset-token
@tenantId = 1
@userId = 3
@roleId = 3
@fileId = 1
@establishmentId = 1
@mediaId = 1
@revisionId = 1
@moderatorToken = replace-with-platform-moderator-access-token
@adminToken = replace-with-platform-admin-access-token
@pilotFeedbackId = 1

###############################################################################
### MOBILE MVP — CONSUMER-FIRST FLOW
###############################################################################
### These requests use the deterministic local development seed documented in
### README.md. They are not production credentials. Run `pnpm ace db:seed`, then
### execute requests in order. REST clients that support named-response variables
### fill tokens, access/offer ids and receipt codes automatically. Otherwise copy
### the corresponding values from the previous response into safe local variables.
### Private mobile responses use `private, no-store`, `noindex, nofollow` and
### `no-referrer`. Authenticated throttling allows 100 requests/minute per user;
### a 429 response includes `Retry-After` and must not be retried before that delay.

### Consumer login — returns auth.token_type, expires_in and refresh_expires_in
# @name mobileConsumerSignIn
POST {{baseUrl}}/api/v1/sessions/sign-in
Content-Type: application/json
Accept: application/json

{
  "uid": "cliente@experimente.local",
  "password": "experimente123"
}

### Rotate the single-use consumer refresh token
# @name mobileConsumerRefresh
POST {{baseUrl}}/api/v1/sessions/refresh
Content-Type: application/json
Accept: application/json

{
  "refresh_token": "{{mobileConsumerSignIn.response.body.$.auth.refresh_token}}"
}

### Bootstrap user, active operation and UI capabilities
# @name mobileContext
GET {{baseUrl}}/api/v1/me/context
Authorization: Bearer {{mobileConsumerRefresh.response.body.$.auth.access_token}}
Accept: application/json

### Partial self-service profile update (email/password/admin fields are not writable)
# @name mobileProfileUpdate
PATCH {{baseUrl}}/api/v1/me
Authorization: Bearer {{mobileConsumerRefresh.response.body.$.auth.access_token}}
Content-Type: application/json
Accept: application/json

{
  "full_name": "Cliente Experimente"
}

### Public discovery — operation comes from trusted Host, city is a discovery dimension
# @name mobileCatalogCities
GET {{baseUrl}}/api/v1/catalog/cities
Host: {{publicHost}}
Accept: application/json

### Public discovery filtered by the canonical `category` query parameter
# @name mobileCatalogSearch
GET {{baseUrl}}/api/v1/catalog/cities/{{catalogCitySlug}}/establishments?q=estacao&category={{catalogCategorySlug}}&page=1&per_page=20
Host: {{publicHost}}
Accept: application/json

### Consumer wallet — empty passes is a valid 200 state
# @name mobileWallet
GET {{baseUrl}}/api/v1/me/wallet
Authorization: Bearer {{mobileConsumerRefresh.response.body.$.auth.access_token}}
x-tenant-id: {{mobileContext.response.body.$.active_operation.id}}
Accept: application/json

### Create a five-minute presentation from the first available wallet benefit
# @name mobilePresentation
POST {{baseUrl}}/api/v1/me/benefits/presentations
Authorization: Bearer {{mobileConsumerRefresh.response.body.$.auth.access_token}}
x-tenant-id: {{mobileContext.response.body.$.active_operation.id}}
Content-Type: application/json
Accept: application/json

{
  "access_id": {{mobileWallet.response.body.$.passes[0].access.id}},
  "offer_id": {{mobileWallet.response.body.$.passes[0].benefits[0].offer_id}}
}

### Partner login — use server capabilities before rendering validation actions
# @name mobilePartnerSignIn
POST {{baseUrl}}/api/v1/sessions/sign-in
Content-Type: application/json
Accept: application/json

{
  "uid": "partner@experimente.local",
  "password": "experimente123"
}

### Bootstrap partner operation and capabilities from the token claim
# @name mobilePartnerContext
GET {{baseUrl}}/api/v1/me/context
Authorization: Bearer {{mobilePartnerSignIn.response.body.$.auth.access_token}}
Accept: application/json

### Preview only; this request does not mutate redemption state
# @name mobileRedemptionPreview
POST {{baseUrl}}/api/v1/benefit-redemptions/preview
Authorization: Bearer {{mobilePartnerSignIn.response.body.$.auth.access_token}}
x-tenant-id: {{mobilePartnerContext.response.body.$.active_operation.id}}
Content-Type: application/json
Accept: application/json

{
  "token": "{{mobilePresentation.response.body.$.token}}"
}

### Confirm redemption; retrying the same token returns the same receipt
# @name mobileRedemption
POST {{baseUrl}}/api/v1/benefit-redemptions
Authorization: Bearer {{mobilePartnerSignIn.response.body.$.auth.access_token}}
x-tenant-id: {{mobilePartnerContext.response.body.$.active_operation.id}}
Content-Type: application/json
Accept: application/json

{
  "token": "{{mobilePresentation.response.body.$.token}}"
}

### Consumer history and receipt
# @name mobileConsumerHistory
GET {{baseUrl}}/api/v1/me/benefits/redemptions
Authorization: Bearer {{mobileConsumerRefresh.response.body.$.auth.access_token}}
x-tenant-id: {{mobileContext.response.body.$.active_operation.id}}
Accept: application/json

# @name mobileConsumerReceipt
GET {{baseUrl}}/api/v1/me/benefits/redemptions/{{mobileRedemption.response.body.$.receipt_code}}
Authorization: Bearer {{mobileConsumerRefresh.response.body.$.auth.access_token}}
x-tenant-id: {{mobileContext.response.body.$.active_operation.id}}
Accept: application/json

### Partner policy-scoped history and receipt
# @name mobilePartnerHistory
GET {{baseUrl}}/api/v1/benefit-redemptions
Authorization: Bearer {{mobilePartnerSignIn.response.body.$.auth.access_token}}
x-tenant-id: {{mobilePartnerContext.response.body.$.active_operation.id}}
Accept: application/json

# @name mobilePartnerReceipt
GET {{baseUrl}}/api/v1/benefit-redemptions/{{mobileRedemption.response.body.$.receipt_code}}
Authorization: Bearer {{mobilePartnerSignIn.response.body.$.auth.access_token}}
x-tenant-id: {{mobilePartnerContext.response.body.$.active_operation.id}}
Accept: application/json

###############################################################################
### HEALTH ENDPOINTS
###############################################################################

### Get API Information
GET {{baseUrl}}/version
Accept: application/json

### Health Check
GET {{baseUrl}}/api/v1/health
Accept: application/json

###############################################################################
### AUTHENTICATION ENDPOINTS
###############################################################################

### Sign In (Login)
# Returns access_token and refresh_token
POST {{baseUrl}}/api/v1/sessions/sign-in
Content-Type: application/json

{
  "uid": "john@example.com",
  "password": "password123"
}

### Sign In with Username
POST {{baseUrl}}/api/v1/sessions/sign-in
Content-Type: application/json

{
  "uid": "johndoe",
  "password": "password123"
}

### Sign Up (Register)
# Creates a new user account and returns tokens. The current API validates the
# acceptance but does not persist versioned evidence of the accepted documents.
POST {{baseUrl}}/api/v1/sessions/sign-up
Content-Type: application/json

{
  "full_name": "John Doe",
  "email": "john@example.com",
  "username": "johndoe",
  "password": "password123",
  "password_confirmation": "password123",
  "terms_accepted": true
}

### Sign Up (Minimal - without username)
POST {{baseUrl}}/api/v1/sessions/sign-up
Content-Type: application/json

{
  "full_name": "Jane Smith",
  "email": "jane@example.com",
  "password": "password123",
  "password_confirmation": "password123",
  "terms_accepted": true
}

### Request Password Reset
# Always returns the same accepted response, even when the email does not exist.
POST {{baseUrl}}/api/v1/sessions/forgot-password
Content-Type: application/json

{
  "email": "john@example.com"
}

### Reset Password
POST {{baseUrl}}/api/v1/sessions/reset-password
Content-Type: application/json

{
  "token": "{{passwordResetToken}}",
  "password": "newpassword123",
  "password_confirmation": "newpassword123"
}

### Rotate Refresh Token
POST {{baseUrl}}/api/v1/sessions/refresh
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

### Revoke Refresh Token
POST {{baseUrl}}/api/v1/sessions/logout
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

###############################################################################
### PROFILE ENDPOINTS (Requires Authentication)
###############################################################################

### Get Current User Profile
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{token}}
Accept: application/json

### Get Current User Permissions
GET {{baseUrl}}/api/v1/me/permissions
Authorization: Bearer {{token}}
Accept: application/json

### Get Current User Roles
GET {{baseUrl}}/api/v1/me/roles
Authorization: Bearer {{token}}
Accept: application/json

### Delete My Account
# Anonymizes the account and revokes active credentials.
DELETE {{baseUrl}}/api/v1/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "current_password": "password123",
  "confirmation": "EXCLUIR MINHA CONTA"
}

###############################################################################
### TENANT ENDPOINTS (Requires Authentication)
###############################################################################

### Create Workspace
# Requires tenants.create and returns a fresh tenant-scoped token pair.
POST {{baseUrl}}/api/v1/tenants
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Acme Workspace"
}

### List My Tenant Memberships
GET {{baseUrl}}/api/v1/tenants/me
Authorization: Bearer {{token}}
Accept: application/json

### Switch Active Tenant and Receive a Fresh Token Pair
POST {{baseUrl}}/api/v1/tenants/switch
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tenant_id": {{tenantId}}
}

