### EMAIL VERIFICATION ENDPOINTS
###############################################################################

### Verify Email
# This endpoint is typically opened from a link in an email
GET {{baseUrl}}/api/v1/verify-email?token=VERIFICATION_TOKEN
Accept: application/json

### Resend Verification Email (Requires Authentication)
POST {{baseUrl}}/api/v1/resend-verification-email
Authorization: Bearer {{token}}
Accept: application/json

###############################################################################
### USER MANAGEMENT ENDPOINTS (Requires Authentication)
###############################################################################

### List Users
# Paginated list with search and sorting
GET {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}
Accept: application/json

### List Users with Pagination
GET {{baseUrl}}/api/v1/users?page=1&per_page=20
Authorization: Bearer {{token}}
Accept: application/json

### List Users with Sorting
GET {{baseUrl}}/api/v1/users?sort_by=created_at&order=desc
Authorization: Bearer {{token}}
Accept: application/json

### Search Users
GET {{baseUrl}}/api/v1/users?search=john
Authorization: Bearer {{token}}
Accept: application/json

### Get User by ID
GET {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Accept: application/json

### Create User (Requires users.create permission)
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "full_name": "New User",
  "email": "newuser@example.com",
  "username": "newuser",
  "password": "password123",
  "password_confirmation": "password123"
}

### Update User
# Note: email and username cannot be changed
PUT {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "full_name": "John Updated Doe"
}

### Update User Password
PUT {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "password": "newpassword123",
  "password_confirmation": "newpassword123"
}

### Delete User (Soft Delete)
DELETE {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}

###############################################################################
### ROLE MANAGEMENT ENDPOINTS (Requires ADMIN or ROOT role)
###############################################################################

### List Roles
GET {{baseUrl}}/api/v1/admin/roles
Authorization: Bearer {{token}}
Accept: application/json

### List Roles with Pagination
GET {{baseUrl}}/api/v1/admin/roles?page=1&per_page=10
Authorization: Bearer {{token}}
Accept: application/json

### Attach Roles to User
PUT {{baseUrl}}/api/v1/admin/roles/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "user_id": 1,
  "role_ids": [
    1,
    2,
    3
  ]
}

### Attach Single Role to User
PUT {{baseUrl}}/api/v1/admin/roles/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "user_id": 2,
  "role_ids": [
    2
  ]
}

###############################################################################
### PERMISSION MANAGEMENT ENDPOINTS (Requires ADMIN or ROOT role)
###############################################################################

### List Permissions
GET {{baseUrl}}/api/v1/admin/permissions
Authorization: Bearer {{token}}
Accept: application/json

### Create Permission
POST {{baseUrl}}/api/v1/admin/permissions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "resource": "posts",
  "action": "create",
  "description": "Allow creating posts"
}

### Sync Role Permissions
PUT {{baseUrl}}/api/v1/admin/roles/permissions/sync
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_id": 2,
  "permission_ids": [
    1,
    2,
    3
  ]
}

### Attach Permissions to Role
PUT {{baseUrl}}/api/v1/admin/roles/permissions/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_id": 2,
  "permission_ids": [
    4,
    5
  ]
}

### Detach Permissions from Role
PUT {{baseUrl}}/api/v1/admin/roles/permissions/detach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_id": 2,
  "permission_ids": [
    1
  ]
}

### Sync User Direct Permissions
PUT {{baseUrl}}/api/v1/admin/users/permissions/sync
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "user_id": 3,
  "permission_ids": [
    10,
    11
  ]
}

### Get User's Direct Permissions
GET {{baseUrl}}/api/v1/admin/users/{{userId}}/permissions
Authorization: Bearer {{token}}
Accept: application/json

### Check User Permissions
POST {{baseUrl}}/api/v1/admin/users/{{userId}}/permissions/check
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "permissions": [
    "users.create",
    "files.delete"
  ]
}

###############################################################################
### FILE MANAGEMENT ENDPOINTS (Requires Authentication)
###############################################################################

### List Workspace Files
GET {{baseUrl}}/api/v1/files?page=1&per_page=20
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Upload File
# Maximum size: 10MB
# Allowed extensions: jpeg, jpg, png, pdf, doc, docx, txt, csv, xls, xlsx, mp3, mp4, zip
# File is automatically categorized: image, document, video, audio, file
POST {{baseUrl}}/api/v1/files/upload
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="document.pdf"
Content-Type: application/pdf

< ./document.pdf
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Upload Image
POST {{baseUrl}}/api/v1/files/upload
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Delete Workspace File
# files.delete deletes any workspace file; files.delete.own only deletes the uploader's file.
DELETE {{baseUrl}}/api/v1/files/{{fileId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}

###############################################################################
### ============================================================================
# ESTABLISHMENT REVIEW AND PUBLICATION ENDPOINTS
# ============================================================================

### Read Partner Review Status
GET {{baseUrl}}/api/v1/establishments/{{establishmentId}}/review
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Submit Editable Revision
# Recomputes completeness under lock. A successful submission freezes the revision.
POST {{baseUrl}}/api/v1/establishments/{{establishmentId}}/submit
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Create Next Draft from Published Revision
# Use "latest_terminal" only when intentionally reusing the most recent approved/rejected revision.
POST {{baseUrl}}/api/v1/establishments/{{establishmentId}}/revisions
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "source": "published"
}

### List Tenant-Scoped Moderation Queue
GET {{baseUrl}}/api/v1/admin/establishment-revisions?page=1&per_page=20
Authorization: Bearer {{moderatorToken}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Read Revision Moderation Detail
GET {{baseUrl}}/api/v1/admin/establishment-revisions/{{revisionId}}
Authorization: Bearer {{moderatorToken}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Request Structured Corrections
POST {{baseUrl}}/api/v1/admin/establishment-revisions/{{revisionId}}/request-changes
Authorization: Bearer {{moderatorToken}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "reason": "A ficha precisa de uma correção antes da publicação",
  "issues": [
    {
      "code": "description_needs_revision",
      "field": "short_description",
      "message": "Explique o principal diferencial da unidade",
      "severity": "blocking"
    }
  ]
}

### Approve and Atomically Publish Revision
# Requires one approved cover, no pending/quarantined media and no open blocking issue.
POST {{baseUrl}}/api/v1/admin/establishment-revisions/{{revisionId}}/approve
Authorization: Bearer {{moderatorToken}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "reason": "Ficha e mídia verificadas"
}

### Reject Revision Without Replacing Current Publication
POST {{baseUrl}}/api/v1/admin/establishment-revisions/{{revisionId}}/reject
Authorization: Bearer {{moderatorToken}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "reason": "A revisão não atende à política editorial"
}

### Suspend Establishment and Preserve Publication History
POST {{baseUrl}}/api/v1/admin/establishments/{{establishmentId}}/suspend
Authorization: Bearer {{adminToken}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "reason": "Verificação administrativa temporária"
}

### Restore Suspended Establishment
POST {{baseUrl}}/api/v1/admin/establishments/{{establishmentId}}/restore
Authorization: Bearer {{adminToken}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "reason": "Verificação concluída"
}

# ============================================================================
# ESTABLISHMENT MEDIA ENDPOINTS
# ============================================================================

### List Administrative Media Composition
GET {{baseUrl}}/api/v1/establishments/{{establishmentId}}/media
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Upload JPEG to Editable Revision
# Supported: JPEG, PNG and WebP, up to 10 MiB. Binary signature, MIME and extension must agree.
POST {{baseUrl}}/api/v1/establishments/{{establishmentId}}/media
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: multipart/form-data; boundary=ExperimenteMediaBoundary
Accept: application/json

--ExperimenteMediaBoundary
Content-Disposition: form-data; name="purpose"

gallery
--ExperimenteMediaBoundary
Content-Disposition: form-data; name="is_cover"

true
--ExperimenteMediaBoundary
Content-Disposition: form-data; name="alt_text"

Fachada principal do estabelecimento
--ExperimenteMediaBoundary
Content-Disposition: form-data; name="caption"

Entrada principal vista da rua
--ExperimenteMediaBoundary
Content-Disposition: form-data; name="file"; filename="valid.jpg"
Content-Type: image/jpeg

< ../tests/fixtures/media/valid.jpg
--ExperimenteMediaBoundary--

### Update Media Metadata
# Changing moderated metadata returns the association to pending review.
PATCH {{baseUrl}}/api/v1/establishments/{{establishmentId}}/media/{{mediaId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "purpose": "exterior",
  "alt_text": "Fachada principal iluminada durante o dia",
  "caption": "Entrada acessível pela rua principal"
}

### Select Cover
PATCH {{baseUrl}}/api/v1/establishments/{{establishmentId}}/media/{{mediaId}}/cover
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Replace Complete Media Order
# Supply every current association exactly once with contiguous positions starting at zero.
PUT {{baseUrl}}/api/v1/establishments/{{establishmentId}}/media/order
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "media": [
    { "id": {{mediaId}}, "sort_order": 0 }
  ]
}

### List Pending Media Moderation Queue
GET {{baseUrl}}/api/v1/admin/media?status=pending&page=1&per_page=20
Authorization: Bearer {{moderatorToken}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Approve Media
# Alternative text is mandatory before approval. Approval does not publish the establishment revision.
POST {{baseUrl}}/api/v1/admin/media/{{mediaId}}/approve
Authorization: Bearer {{moderatorToken}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{}

### Reject Media
POST {{baseUrl}}/api/v1/admin/media/{{mediaId}}/reject
Authorization: Bearer {{moderatorToken}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "reason": "A imagem não representa o estabelecimento informado"
}

### Quarantine Media
# Quarantined media is removed from cover eligibility and blocks submission while associated.
POST {{baseUrl}}/api/v1/admin/media/{{mediaId}}/quarantine
Authorization: Bearer {{moderatorToken}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "reason": "Conteúdo requer análise adicional antes de qualquer exposição"
}

### Read Approved Public Media
# No authentication. Returns only approved media from the published revision.
GET {{baseUrl}}/api/v1/public/establishments/{{establishmentId}}/media
Accept: application/json

### Remove Media from Editable Revision
# The physical object is removed only after the final revision reference disappears.
DELETE {{baseUrl}}/api/v1/establishments/{{establishmentId}}/media/{{mediaId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json


# ============================================================================
# PUBLIC CATALOG — EP-06
# ============================================================================

### List Published Cities
GET {{baseUrl}}/api/v1/catalog/cities
Host: {{publicHost}}
Accept: application/json

### List Categories Available in a City
GET {{baseUrl}}/api/v1/catalog/cities/{{catalogCitySlug}}/categories
Host: {{publicHost}}
Accept: application/json

### Search Published Establishments
GET {{baseUrl}}/api/v1/catalog/cities/{{catalogCitySlug}}/establishments?q=estacao&category={{catalogCategorySlug}}&page=1&per_page=20
Host: {{publicHost}}
Accept: application/json

### Filter Establishments Open Now
GET {{baseUrl}}/api/v1/catalog/cities/{{catalogCitySlug}}/establishments?open_now=true&page=1&per_page=20
Host: {{publicHost}}
Accept: application/json

### Read a Published Establishment by Slugs
GET {{baseUrl}}/api/v1/catalog/cities/{{catalogCitySlug}}/establishments/{{catalogEstablishmentSlug}}
Host: {{publicHost}}
Accept: application/json

### Public SSR — Cities
GET {{baseUrl}}/cidades
Host: {{publicHost}}
Accept: text/html

### Public SSR — City Catalog
GET {{baseUrl}}/cidades/{{catalogCitySlug}}
Host: {{publicHost}}
Accept: text/html

### Public SSR — Category
GET {{baseUrl}}/cidades/{{catalogCitySlug}}/categorias/{{catalogCategorySlug}}
Host: {{publicHost}}
Accept: text/html

### Public SSR — Establishment
GET {{baseUrl}}/cidades/{{catalogCitySlug}}/estabelecimentos/{{catalogEstablishmentSlug}}
Host: {{publicHost}}
Accept: text/html

# ============================================================================
# DISCOVERY ANALYTICS — EP-07
# ============================================================================

### Ingest Privacy-Safe Discovery Events
POST {{baseUrl}}/api/v1/analytics/events
Host: {{publicHost}}
Content-Type: application/json
Accept: application/json

{
  "events": [
    {
      "event_id": "{{analyticsEventId}}",
      "event_type": "establishment_view",
      "city_slug": "{{catalogCitySlug}}",
      "establishment_slug": "{{catalogEstablishmentSlug}}"
    }
  ]
}

### Read Organization Discovery Dashboard
GET {{baseUrl}}/api/v1/organizations/{{organizationId}}/analytics?from=2026-08-01&to=2026-08-31
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Read Organization Analytics Page
GET {{baseUrl}}/organizations/{{organizationId}}/analytics?from=2026-08-01&to=2026-08-31
Cookie: experimente-plus-session=replace-with-browser-session
x-tenant-id: {{tenantId}}
Accept: text/html

### List Searches Without Results
GET {{baseUrl}}/api/v1/admin/analytics/searches/no-results?from=2026-08-01&to=2026-08-31&page=1&per_page=20
Authorization: Bearer {{adminToken}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Tracked Route Redirect
# The destination is derived from the published projection; clients never submit an arbitrary URL.
GET {{baseUrl}}/go/{{catalogCitySlug}}/{{catalogEstablishmentSlug}}/route
Host: {{publicHost}}
Accept: text/html

### Tracked WhatsApp Redirect
GET {{baseUrl}}/go/{{catalogCitySlug}}/{{catalogEstablishmentSlug}}/whatsapp
Host: {{publicHost}}
Accept: text/html

### Tracked Phone Redirect
GET {{baseUrl}}/go/{{catalogCitySlug}}/{{catalogEstablishmentSlug}}/phone
Host: {{publicHost}}
Accept: text/html

### Tracked Website Redirect
GET {{baseUrl}}/go/{{catalogCitySlug}}/{{catalogEstablishmentSlug}}/website
Host: {{publicHost}}
Accept: text/html

# ============================================================================
# PILOT FEEDBACK · EP-08
# ============================================================================

### Submit General Pilot Feedback
POST {{baseUrl}}/api/v1/pilot-feedback
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "context": "onboarding",
  "rating": 4,
  "message": "O checklist deixou claro o que ainda falta para publicar a unidade.",
  "organization_id": {{organizationId}}
}

### Submit Establishment Feedback
POST {{baseUrl}}/api/v1/pilot-feedback
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "context": "establishment",
  "rating": 5,
  "message": "A edição de endereço, horários e categorias funcionou bem no cadastro assistido.",
  "organization_id": {{organizationId}},
  "establishment_id": {{establishmentId}}
}

### List Pilot Feedback as Administrator
GET {{baseUrl}}/api/v1/admin/pilot-feedback?status=new&page=1&per_page=20
Authorization: Bearer {{adminToken}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Review Pilot Feedback as Administrator
PATCH {{baseUrl}}/api/v1/admin/pilot-feedback/{{pilotFeedbackId}}
Authorization: Bearer {{adminToken}}
x-tenant-id: {{tenantId}}
Content-Type: application/json
Accept: application/json

{
  "status": "resolved",
  "internal_notes": "Validado com o parceiro e convertido em item do backlog."
}

