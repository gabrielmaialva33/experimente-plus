# Business policy: development | homologation | production.
# Missing means production (fail closed); invalid values abort startup.
# Public homologation uses homologation even with NODE_ENV=production.
DEPLOYMENT_ENV=development
TZ=UTC
HOST=localhost
PORT=3333
NODE_ENV=development
LOG_LEVEL=info
APP_LOCALE=pt

APP_NAME="Experimente+"
VITE_APP_NAME="Experimente+"
APP_URL=http://localhost:3333
APP_SOURCE_URL=https://github.com/gabrielmaialva33/experimente-plus
# Optional canonical HTTP(S) origin used by benefit QR validation links.
# It must not contain credentials, a path, query parameters, or a fragment.
# Homologation and production require canonical HTTPS; HTTP is local/test only.
# BENEFIT_PRESENTATION_BASE_URL=https://experimente.example.com
# Addresses allowed to supply X-Forwarded-* headers. Keep loopback locally;
# docker-compose.vps.yml overrides this for the private Docker gateway.
TRUST_PROXY=loopback
# Optional when exactly one active operation exists. Required for shared multi-operation hosts.
PUBLIC_TENANT_SLUG=development
APP_KEY=
# Use independent high-entropy secrets in production. During local development,
# these secrets fall back to APP_KEY when omitted.
# ACCESS_TOKEN_SECRET=
# REFRESH_TOKEN_SECRET=
# EMAIL_VERIFICATION_SECRET=
# PASSWORD_RESET_SECRET=
PASSWORD_RESET_TTL_MINUTES=60
JWT_ISSUER=experimente-plus
JWT_AUDIENCE=experimente-plus
JWT_COOKIE_NAME=experimente-plus-token
SESSION_COOKIE_NAME=experimente-plus-session

# none | personal | operation. Experimente+ attaches public registrations to the configured operation.
REGISTRATION_WORKSPACE_MODE=operation
# Homologation and production require this independent secret; APP_KEY is a local fallback.
# ORGANIZATION_INVITATION_SECRET=
ORGANIZATION_INVITATION_TTL_HOURS=72
ANALYTICS_HASH_SECRET=change-me-with-at-least-32-random-characters
ANALYTICS_RAW_RETENTION_DAYS=90
ANALYTICS_AGGREGATE_RETENTION_MONTHS=25
ANALYTICS_SESSION_COOKIE_DAYS=30
DEMO_PAGES_ENABLED=false

# Deterministic development account created by `pnpm ace db:seed`.
DEV_ADMIN_NAME="Experimente+ Admin"
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_EMAIL=admin@experimente.local
DEV_ADMIN_PASSWORD=experimente123
DEV_PARTNER_NAME="Parceiro Experimente+"
DEV_PARTNER_USERNAME=partner
DEV_PARTNER_EMAIL=partner@experimente.local
DEV_PARTNER_PASSWORD=experimente123
DEV_CUSTOMER_NAME="Cliente Experimente+"
DEV_CUSTOMER_USERNAME=cliente
DEV_CUSTOMER_EMAIL=cliente@experimente.local
DEV_CUSTOMER_PASSWORD=experimente123
DEV_WORKSPACE_NAME="Experimente+ Development"

SESSION_DRIVER=cookie
LIMITER_STORE=database

# Drive (file storage): fs | s3 | spaces | r2 | gcs
DRIVE_DISK=fs

# Database Configuration (PostgreSQL)
# DB_CONNECTION selects the connection in config/database.ts (postgres | sqlite)
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=experimente_plus

# Redis (cache + sessions)
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=redis
REDIS_DB=0

# Mail Configuration
# MAIL_MAILER: smtp | mailgun
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Experimente+"

# SMTP Configuration. The bundled Docker environment exposes Mailpit on
# localhost:1026 and its inbox UI on http://localhost:8026.
SMTP_HOST=localhost
SMTP_PORT=1026
MAILPIT_UI_PORT=8026
SMTP_USER=
SMTP_PASS=

# Mailgun Configuration (when MAIL_MAILER=mailgun)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain
# MAILGUN_BASE_URL=https://api.mailgun.net/v3

# ---------------------------------------------------------------------------
# Optional integrations (uncomment and fill in as needed)
# ---------------------------------------------------------------------------

# S3 (when DRIVE_DISK=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# DigitalOcean Spaces (when DRIVE_DISK=spaces)
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_REGION=
# SPACES_BUCKET=
# SPACES_ENDPOINT=

# Cloudflare R2 (when DRIVE_DISK=r2)
# R2_KEY=
# R2_SECRET=
# R2_BUCKET=
# R2_ENDPOINT=

# Google Cloud Storage (when DRIVE_DISK=gcs)
# GCS_KEY=
# GCS_BUCKET=

# Payments: deployment policy is independent from the Node runtime.
# Business production requires live; fake is only allowed outside business production.
PAYMENT_PROVIDER=disabled
PAYMENT_METHODS=none
PAYMENT_ENVIRONMENT=test
STRIPE_ENVIRONMENT=test
# STRIPE_ACCOUNT_ID=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_RESTRICTED_KEY=
# Required for Stripe on homologation/production; development may use polling only.
# STRIPE_WEBHOOK_SECRET=

#
# Concierge IA (ADR-0029)
#
# Provedor, modelos, limite de tempo e limites de consumo são configuração por
# decisão do ADR: modelos listados pelo provedor deixam de ser servíveis sem
# aviso, e trocar um nome não pode exigir release. Sem NVIDIA_API_KEY o módulo
# responde pelo caminho degradado, com a lista do catálogo e sem texto gerado.
#
CONCIERGE_ENABLED=false
CONCIERGE_BASE_URL=https://integrate.api.nvidia.com/v1
CONCIERGE_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b
CONCIERGE_FALLBACK_MODEL=mistralai/mistral-nemotron
CONCIERGE_TIMEOUT_MS=10000
CONCIERGE_MAX_OUTPUT_TOKENS=400
CONCIERGE_MAX_CATALOG_ITEMS=20
CONCIERGE_DAILY_LIMIT_PER_USER=20
NVIDIA_API_KEY=
