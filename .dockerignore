# Adonis default .gitignore ignores
node_modules
build
dist
coverage
.vscode
.DS_STORE
.env
.env.local
.env.*.local
**/.env.*.local
tmp

# Additional .gitignore ignores (any custom file you wish)
.idea

# Additional good to have ignores for dockerignore
Dockerfile*
docker-compose*
.dockerignore
*.md
.git
.gitignore

# Operational secrets and logs must never enter COPY . . (including untracked files).
.bootstrap-credentials
**/.bootstrap-credentials*
build.log
**/*.log

# Persistent media belongs in runtime volumes, never in image layers/build cache.
storage/uploads/**
storage/seed-media/**
